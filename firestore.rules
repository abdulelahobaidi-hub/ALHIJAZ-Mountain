rules_version = '2';

// نادي جبال الحجاز — قواعد الأمان
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me()       { return request.auth.uid; }

    // بيانات كل مستخدم الخاصة: جداوله وسجل تمارينه
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && me() == userId;
    }

    // الملف العام: الاسم والصورة والستريك — يقرأه الأعضاء، ويكتبه صاحبه فقط
    match /profiles/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == userId;

      // نسخة معروضة من جداوله يشوفها أصدقاؤه
      match /plans/{planId} {
        allow read:  if signedIn();
        allow write: if signedIn() && me() == userId;
      }
    }

    // طلبات الصداقة: يرسلها الطرف الأول، ويقبلها أو يرفضها الثاني
    match /friendRequests/{reqId} {
      allow read:   if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && request.resource.data.from == me()
                    && request.resource.data.to != me();
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow update: if false;
    }

    // المحادثات الخاصة — معرّف المحادثة هو uid_uid لطرفيها
    match /dms/{pair} {
      function inPair() { return signedIn() && me() in pair.split('_'); }
      allow read, write: if inPair();

      match /messages/{mid} {
        function inPair2() { return signedIn() && me() in pair.split('_'); }
        allow read:   if inPair2();
        allow create: if inPair2() && request.resource.data.uid == me();
        allow delete: if inPair2() && resource.data.uid == me();
        allow update: if false;
      }
    }

    // أرقام العضوية: للبحث عن عضو برقمه
    match /memberIds/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update, delete: if false;
    }

    // الصداقات: طرفاها فقط
    match /friendships/{pair} {
      allow read:   if signedIn() && (resource.data.a == me() || resource.data.b == me());
      allow create: if signedIn() && (request.resource.data.a == me() || request.resource.data.b == me());
      allow delete: if signedIn() && (resource.data.a == me() || resource.data.b == me());
      allow update: if false;
    }

    // أكواد الدعوة
    match /groupCodes/{code} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // التحدي الثنائي — معرّفه uid_uid لطرفيه
    match /duels/{pair} {
      function inPair() { return signedIn() && me() in pair.split('_'); }
      allow read, write: if inPair();
    }

    // القروبات
    match /groups/{gid} {

      function isMember() { return signedIn() && me() in resource.data.memberUids; }
      // المشرفون: قائمة admins إن وُجدت، وإلا المؤسس وحده
      function admins() {
        return ('admins' in resource.data) ? resource.data.admins : [resource.data.ownerUid];
      }
      function isAdmin() { return signedIn() && me() in admins(); }
      function newData() { return request.resource.data; }
      function smallPhoto() {
        return !('photo' in newData()) || newData().photo.size() < 60000;
      }
      function onlyMembersChanged() {
        return newData().diff(resource.data).affectedKeys().hasOnly(['memberUids']);
      }
      // المشرف يعدّل الاسم والصورة والتحدي والأعضاء والمشرفين — ويبقى المؤسس مشرفاً دائماً
      function adminEdit() {
        return isAdmin()
               && newData().ownerUid == resource.data.ownerUid
               && resource.data.ownerUid in newData().admins
               && smallPhoto();
      }
      // العضو العادي: يغادر القروب فقط
      function memberLeaves() {
        return isMember()
               && onlyMembersChanged()
               && !(me() in newData().memberUids)
               && resource.data.memberUids.hasAll(newData().memberUids);
      }
      // غير العضو: ينضم بالكود — يضيف نفسه فقط ولا يغيّر شيئاً آخر
      function joinsByCode() {
        return signedIn()
               && onlyMembersChanged()
               && me() in newData().memberUids
               && newData().memberUids.hasAll(resource.data.memberUids)
               && newData().memberUids.size() == resource.data.memberUids.size() + 1;
      }

      allow read: if isMember();

      allow create: if signedIn()
                    && request.resource.data.ownerUid == me()
                    && request.resource.data.memberUids == [me()]
                    && request.resource.data.admins == [me()];

      allow update: if adminEdit() || memberLeaves() || joinsByCode();

      allow delete: if signedIn() && resource.data.ownerUid == me();

      // المحادثة وسجل النشاط
      match /messages/{mid} {
        function member() {
          return signedIn()
                 && me() in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
        }
        allow read:   if member();
        allow create: if member() && request.resource.data.uid == me();
        // التفاعل (👏) فقط — ما أحد يعدّل نص رسالة غيره
        allow update: if member()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claps']);
        allow delete: if member() && resource.data.uid == me();
      }

      // الجداول المنشورة للقروب
      match /plans/{pid} {
        function member() {
          return signedIn()
                 && me() in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
        }
        allow read:   if member();
        allow create: if member() && request.resource.data.byUid == me();
        allow delete: if member() && resource.data.byUid == me();
        allow update: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
